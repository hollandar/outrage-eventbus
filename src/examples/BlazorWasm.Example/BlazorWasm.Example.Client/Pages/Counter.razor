@page "/counter"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject Outrage.EventBus.IClientEventBus EventBus

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;
    
    record TestEvent(int Value) : Outrage.EventBus.IMessage;

    protected override Task OnInitializedAsync()
    {
        EventBus.Subscribe<TestEvent>(async (c, e) =>
        {
            this.currentCount = e.Value;
            await InvokeAsync(StateHasChanged);
        });

        return base.OnInitializedAsync();
    }

    private async Task IncrementCount()
    {
        await EventBus.PublishAsync(new TestEvent(currentCount + 1));
    }
}
